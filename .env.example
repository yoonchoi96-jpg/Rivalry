# Copy to .env and fill in. Never commit real secrets.
RIVALRY_ENV=development
RIVALRY_LOG_LEVEL=INFO
# When set, /api/v1 requires header X-API-Key (leave empty only for local dev)
RIVALRY_API_KEY=
RIVALRY_DATABASE_URL=******localhost:5432/rivalry
RIVALRY_REDIS_URL=redis://localhost:6379/0
RIVALRY_WORKER_POLL_INTERVAL=1.0
# Test-only database for integration tests (pytest -m integration)
RIVALRY_TEST_DATABASE_URL=

# AI providers (leave empty to disable)
RIVALRY_AI_PROVIDERS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
NAVER_AI_API_KEY=
NAVER_AI_API_URL=
RIVALRY_QWEN_BASE_URL=
DASHSCOPE_BASE_URL=
RIVALRY_DEEPSEEK_BASE_URL=https://api.deepseek.com
RIVALRY_XAI_BASE_URL=https://api.x.ai/v1

# Model overrides (optional)
RIVALRY_AI_CHAT_MODEL=
RIVALRY_AI_EXPERT_MODEL=
RIVALRY_AI_INTELLIGENCE_MODEL=
RIVALRY_AI_OPENAI_RESEARCH_MODEL=
RIVALRY_AI_CLAUDE_MODEL=
RIVALRY_AI_CLAUDE_MAX_TOKENS=4096
RIVALRY_AI_GEMINI_MODEL=
RIVALRY_AI_PERPLEXITY_MODEL=
RIVALRY_PERPLEXITY_PRESET=pro-search
RIVALRY_AI_NAVER_MODEL=HCX-005
RIVALRY_AI_NAVER_TIMEOUT=30
